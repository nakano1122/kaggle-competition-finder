{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaggle-competition-finder",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "../web/dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
}
